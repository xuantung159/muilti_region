# Sao chép thành .env.local rồi chỉnh. Không đặt AWS access key hay secret vào đây:
# mọi biến VITE_* đều bị nhúng vào file JavaScript công khai khi build.

# Chế độ dữ liệu mặc định khi người dùng chưa chỉnh trong Settings: mock | live.
# Bỏ trống: bản build production dùng live, chỉ `npm run dev` dùng mock.
VITE_DEFAULT_DATA_MODE=mock

# URL gốc của backend giám sát (xem docs/integration/backend-api.md). Để trống = chưa kết nối.
VITE_MONITORING_API_URL=

# API doanh nghiệp, URL gốc bao gồm stage nếu có (không thêm /api).
# Để trống khi dùng cùng origin hoặc proxy Vite bên dưới.
VITE_PORTAL_API_URL=

# Chỉ dùng khi chạy dev: proxy /api tới Lambda dashboard qua API Gateway.
# Ví dụ https://<api-id>.execute-api.ap-southeast-1.amazonaws.com/demo
PORTAL_API_TARGET=
