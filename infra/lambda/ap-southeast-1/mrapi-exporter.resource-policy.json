{
  "Version": "2012-10-17",
  "Id": "default",
  "Statement": [
    {
      "Sid": "mrapi-export-daily",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-southeast-1:138150704839:function:mrapi-exporter",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:events:ap-southeast-1:138150704839:rule/mrapi-export-daily"
        }
      }
    }
  ]
}
