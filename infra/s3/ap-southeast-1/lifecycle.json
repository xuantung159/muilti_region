{
  "TransitionDefaultMinimumObjectSize": "all_storage_classes_128K",
  "Rules": [
    {
      "ID": "mrapi-telemetry-cleanup",
      "Filter": {
        "Prefix": "exports/telemetry/"
      },
      "Status": "Enabled",
      "NoncurrentVersionExpiration": {
