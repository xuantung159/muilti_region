{
    "Rules": [
        {
            "ID": "mrapi-telemetry-cleanup",
            "Filter": {
                "Prefix": "exports/telemetry/"
            },
            "Status": "Enabled",
            "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
            },
            "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
            }
        }
    ]
}
